{
  "name": "dori-superagent",
  "version": "0.1.2",
  "description": "Dori's complete upstream harness and messenger skill ported to OMP.",
  "type": "module",
  "license": "SUL-1.0",
  "packageManager": "bun@1.4.4",
  "bin": {
    "dori-harness": "src/cli.ts"
  },
  "scripts": {
    "check": "biome check .",
    "fmt": "biome format --write .",
    "typecheck": "bun scripts/typecheck.ts",
    "lint:loc": "bun scripts/check-loc.ts",
    "knip": "knip",
    "test": "bun test ./test/",
    "test:ci": "bun test --parallel=2 --timings=.bun-test-timings.json ./test/",
    "test:skill": "cd skills/dori-mode/scripts && bun test",
    "test:extension": "cd extension && bun test",
    "ci": "bun run check && bun run typecheck && bun run knip && bun run lint:loc && bun run test:ci && bun run test:skill && bun run test:extension"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "knip": "^6.44.2",
    "typescript": "^5.9"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
