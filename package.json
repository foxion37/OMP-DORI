{
  "name": "cataly",
  "version": "0.1.4",
  "description": "Cataly session harness and messenger skill for OMP.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "bin": {
    "cataly-harness": "src/cli.ts"
  },
  "scripts": {
    "check": "bun run lint && bun run format:check",
    "check:fixtures": "bun scripts/check-test-fixtures.ts",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "typecheck": "bun scripts/typecheck.ts",
    "lint:loc": "bun scripts/check-loc.ts",
    "knip": "knip",
    "test": "bun test ./test/",
    "test:ci": "bun test --parallel=1 --timings=.bun-test-timings.json ./test/",
    "test:skill": "cd skills/cataly-mode/scripts && bun test",
    "test:extension": "cd extension && bun test",
    "dev:setup": "bun scripts/dev-setup.ts",
    "test:local": "bun scripts/test-local.ts",
    "ci": "bun run check:fixtures && bun run check && bun run typecheck && bun run knip && bun run lint:loc && bun run test:ci && bun run test:skill && bun run test:extension"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "oxlint": "1.94.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
