{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/update-supervisor.ts",
        "scripts/source-dependencies.ts",
        "scripts/source-configuration.ts",
        "scripts/previous-install/cli.ts",
        "scripts/check-native-doctor.ts",
        "scripts/verify-consumer-release.ts",
        "scripts/consumer-smoke-candidate.ts",
        "scripts/consumer-smoke-harness.ts",
        "src/update/deployment-launcher.ts",
        "src/release/automatic.ts",
        "src/release/references.ts",
        "src/runtime/headless-loop.ts",
        "src/update/reviewer-guard.ts",
        "src/update/worker-guard.ts",
        "test/fixtures/headless-rpc.ts",
        "test/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "skills/cataly-mode/scripts": {
      "entry": [
        "test/**/*.test.ts",
        "test/record-gateway.ts",
        "test/record-fetch.ts",
        "test/record-inbound-activity-failure.ts",
        "test/record-slack-activity-backlog.ts",
        "test/record-discord.ts",
        "test/record-telegram-startup.ts",
        "test/record-telegram-epoch.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "extension": {
      "entry": ["index.ts", "test/**/*.test.ts", "test/record-head-inbound.ts"],
      "project": ["**/*.ts"]
    },
    "test/fixtures/omp-native-host": {
      "entry": ["compose.ts"],
      "project": ["compose.ts", "host.ts"]
    }
  },
  "ignoreExportsUsedInFile": true
}
