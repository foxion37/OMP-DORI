{
  "version": 1,
  "target": "cataly",
  "root": "../../cataly-update-staging",
  "remote": "https://github.com/vntrevx/Cataly.git",
  "ref": "refs/heads/main",
  "baseUpstream": "47c4be0c79f1e34762d7c1b248dca1bbbb6fb731",
  "localSource": "..",
  "intervalSeconds": 300,
  "modelEnv": ["ANTHROPIC_API_KEY"],
  "reporterEnv": [],
  "worker": {
    "name": "port",
    "engine": "omp",
    "argv": ["omp", "-p", "--model", "anthropic/claude-opus-5-5", "--thinking", "high", "{prompt}"],
    "timeoutMs": 3600000
  },
  "reviewer": {
    "name": "fresh-review",
    "engine": "omp",
    "argv": ["omp", "-p", "--model", "anthropic/claude-opus-5-5", "--thinking", "xhigh", "{prompt}"],
    "timeoutMs": 3600000
  },
  "provision": [
    {
      "name": "install-root",
      "argv": ["bun", "install", "--frozen-lockfile", "--ignore-scripts"],
      "timeoutMs": 300000
    },
    {
      "name": "install-skill",
      "argv": ["bun", "install", "--frozen-lockfile", "--ignore-scripts"],
      "cwd": "skills/cataly-mode/scripts",
      "timeoutMs": 300000
    },
    {
      "name": "install-extension",
      "argv": ["bun", "install", "--frozen-lockfile", "--ignore-scripts"],
      "cwd": "extension",
      "timeoutMs": 300000
    },
    { "name": "normalize-source", "argv": ["bun", "run", "format"], "timeoutMs": 300000 }
  ],
  "checks": [
    { "name": "lint", "argv": ["bun", "run", "check"], "timeoutMs": 300000 },
    { "name": "types", "argv": ["bun", "run", "typecheck"], "timeoutMs": 300000 },
    { "name": "unused", "argv": ["bun", "run", "knip"], "timeoutMs": 300000 },
    { "name": "source-size", "argv": ["bun", "run", "lint:loc"], "timeoutMs": 300000 },
    { "name": "harness-tests", "argv": ["bun", "run", "test"], "timeoutMs": 600000 },
    { "name": "skill-tests", "argv": ["bun", "run", "test:skill"], "timeoutMs": 600000 },
    { "name": "extension-tests", "argv": ["bun", "run", "test:extension"], "timeoutMs": 300000 }
  ]
}
