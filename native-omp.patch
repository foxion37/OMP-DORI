+import { describe, expect, it } from "bun:test";
+import { type TodoPhase, todoTaskTargets } from "../src/tools/todo";
+
+function phasesWith(...contents: string[]): TodoPhase[] {
+	return [{ name: "Work", tasks: contents.map(content => ({ content, status: "pending" })) }];
+}
+
+describe("todo task targets shared by the tool and renderer", () => {
+	for (const name of ["a; b", "a, b", "a b", "a\nb"]) {
+		it(`keeps the verbatim full name ${JSON.stringify(name)} ahead of list recovery`, () => {
+			const phases = phasesWith("a", "b", name);
+			expect(todoTaskTargets(phases, name)).toEqual([name]);
+			expect(todoTaskTargets(phases, [name])).toEqual([name]);
+		});
+	}
+
+	for (const [label, input] of [
+		["newline", "a\nb"],
+		["semicolon", "a; b"],
+		["comma", "a, b"],
+		["unambiguous whitespace", "a b"],
+	] as const) {
+		it(`recovers ${label}-separated known task names`, () => {
+			expect(todoTaskTargets(phasesWith("a", "b"), input)).toEqual(["a", "b"]);
+		});
+	}
+
+	it("trims and unquotes recovered parts and expands array entries across phases", () => {
+		const phases: TodoPhase[] = [
+			...phasesWith("a", "b"),
+			{ name: "Later", tasks: [{ content: "c", status: "pending" }] },
+		];
+		const targets: readonly string[] = [' "a"; `b` ', " 'c' "];
+		expect(todoTaskTargets(phases, targets)).toEqual(["a", "b", "c"]);
+	});
+
+	for (const separator of ["\n", ";", ","]) {
+		it(`retains each missing part of a partial ${JSON.stringify(separator)} list for an individual error`, () => {
+			expect(todoTaskTargets(phasesWith("a"), `a${separator} missing`)).toEqual(["a", "missing"]);
+		});
+	}
+
+	it("does not split an ambiguous whitespace-containing missing name", () => {
+		expect(todoTaskTargets(phasesWith("a"), "a missing task")).toEqual(["a missing task"]);
+	});
+
+	it("preserves an unknown full input when no delimiter part names a task", () => {
+		expect(todoTaskTargets(phasesWith("a"), "missing; other")).toEqual(["missing; other"]);
+	});
+
+	it("distinguishes an empty array entry from an absent target list", () => {
+		const phases = phasesWith("a");
+		expect(todoTaskTargets(phases, undefined)).toEqual([]);
+		expect(todoTaskTargets(phases, "")).toEqual([]);
+		expect(todoTaskTargets(phases, [])).toEqual([]);
+		expect(todoTaskTargets(phases, [""])).toEqual([""]);
+	});
+});
